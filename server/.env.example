# Copy to .env (never commit .env). Real values stay on your device/server only.
PORT=8787
# The email that becomes OWNER after it is verified (first owner only)
OWNER_EMAIL=you@example.com
# Browser addresses allowed to call the API (comma separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Used to build links in emails
APP_ORIGIN=http://localhost:5173
